# Ogoh configuration. Copy to .env and fill in. .env is gitignored.
# Every value below has a default in code except the ones under Core — uncomment
# and set only what you want to change from the default shown.

# ── Core ─────────────────────────────────────────────────────────────────────
# Gemini key from https://aistudio.google.com/apikey — needed for enrichment.
# Several keys, comma-separated, are rotated for load-spread and 429 failover:
#   GEMINI_API_KEY=key_one,key_two
GEMINI_API_KEY=
# Telegram bot token from @BotFather (/newbot). Needed to run the bot.
TELEGRAM_BOT_TOKEN=
# Your numeric id (message @userinfobot). Only for the CLI's --send diagnostic;
# the multi-user bot does not use it.
TELEGRAM_CHAT_ID=

# ── LLM ──────────────────────────────────────────────────────────────────────
# GEMINI_MODEL=gemini-3.1-flash-lite
# Optional fallback provider on separate quota. Enrichment/dedupe/research drop
# to Groq when Gemini fails. Off unless a key is set.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Storage ──────────────────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///ogoh.db
# Optional Redis for the bot FSM (keeps /ask conversations across a restart).
# Needs the redis package; falls back to memory if unset or unreachable.
# REDIS_URL=redis://localhost:6379/0

# ── Pipeline ─────────────────────────────────────────────────────────────────
# ENRICH_BATCH_SIZE=20
# MIN_IMPORTANCE=5
# DIGEST_LIMIT=10
# MAX_AGE_DAYS=14
# RESEARCH_PER_RUN=1
# RAW_TEXT_RETENTION_DAYS=90        # 0 disables pruning of old article text

# ── Admin panel (ogoh-admin) ─────────────────────────────────────────────────
# The one Telegram id allowed to log in (run /admin in the bot for a code).
# 0 means the panel refuses every login.
# ADMIN_TELEGRAM_ID=0
# Signs the login cookie. Blank derives it from the bot token.
# ADMIN_SESSION_SECRET=
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=8000

# ── Research agent (/ask) ────────────────────────────────────────────────────
# Web search key from https://tavily.com — without it the agent is corpus-only.
# TAVILY_API_KEY=
# SEARCH_MAX_RESULTS=5
# AGENT_MODEL=gemini-3.1-flash-lite
# AGENT_MODEL_HEAVY=gemini-3.5-flash   # escalated to on hard turns; blank/= disables
# AGENT_DAILY_BUDGET=10                # questions per user per day
# AGENT_MAX_TOOL_CALLS=5               # hard cap on one question's loop
# AGENT_MAX_WEB_SEARCHES=3
# AGENT_MAX_FETCHES=2
# AGENT_OBS_CHAR_CAP=2000              # trim each tool observation to this
# AGENT_HISTORY_TURNS=12               # only the last N turns are re-sent
# AGENT_CACHE_TTL_HOURS=6
# AGENT_IDLE_TIMEOUT_MINUTES=5
# AGENT_MESSAGE_RETENTION_DAYS=30      # transcript + usage retention; 0 disables
